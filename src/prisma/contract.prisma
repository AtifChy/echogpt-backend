// use prisma-8
model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]

  @@map("role")
}

enum RoleName {
  ADMIN
  USER
}

model User {
  id            Int                        @id @default(autoincrement())
  email         String                     @unique
  passwordHash  String
  displayName   String?
  status        UserStatus
  roleId        Int
  role          Role                       @relation(fields: [roleId], references: [id])
  sessions      Session[]
  subscriptions Subscription?
  conversations Conversation[]
  searches      WebSearch[]
  usageLogs     ApiUsageLog[]
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([roleId])
  @@index([status])
  @@map("user")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Session {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String             @unique
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  createdAt TimestamptzString  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Subscription {
  id                 Int                        @id @default(autoincrement())
  userId             Int                        @unique
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan
  status             SubscriptionStatus
  currentPeriodStart TimestamptzString
  currentPeriodEnd   TimestamptzString
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([plan, status])
  @@map("subscription")
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

model AiProvider {
  id              Int                        @id @default(autoincrement())
  name            String
  type            ProviderType
  model           String
  encryptedApiKey String
  apiKeyIv        String
  apiKeyAuthTag   String
  enabled         Boolean                    @default(false)
  isDefault       Boolean                    @default(false)
  conversations   Conversation[]
  usageLogs       ApiUsageLog[]
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([type])
  @@index([enabled, isDefault])
  @@map("ai_provider")
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
}

model Conversation {
  id         Int                        @id @default(autoincrement())
  userId     Int
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId Int
  provider   AiProvider                 @relation(fields: [providerId], references: [id])
  title      String
  messages   Message[]
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([userId, updatedAt])
  @@index([providerId])
  @@map("conversation")
}

model Message {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sources        MessageSource[]
  role           MessageRole
  content        String
  inputTokens    Int               @default(0)
  outputTokens   Int               @default(0)
  createdAt      TimestamptzString @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

model MessageSource {
  id          Int     @id @default(autoincrement())
  messageId   Int
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  citation    Int
  title       String
  url         String
  hostname    String?
  publishedAt String?

  @@unique([messageId, citation])
  @@map("message_source")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

model WebSearch {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  query           String
  normalizedQuery String
  results         SearchResult[]
  createdAt       TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([normalizedQuery, createdAt])
  @@map("web_search")
}

model SearchResult {
  id       Int       @id @default(autoincrement())
  searchId Int
  search   WebSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  title    String
  url      String
  snippet  String

  @@unique([searchId, url])
  @@index([searchId])
  @@map("search_result")
}

model ApiUsageLog {
  id           Int               @id @default(autoincrement())
  userId       Int
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId   Int?
  provider     AiProvider?       @relation(fields: [providerId], references: [id])
  operation    ApiUsageOperation
  status       ApiUsageStatus
  inputTokens  Int               @default(0)
  outputTokens Int               @default(0)
  latencyMs    Int               @default(0)
  createdAt    TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([providerId, createdAt])
  @@index([operation, status, createdAt])
  @@map("api_usage_log")
}

enum ApiUsageOperation {
  CHAT
  SEARCH
}

enum ApiUsageStatus {
  SUCCESS
  FAILED
}
