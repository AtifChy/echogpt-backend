// use prisma-8
model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id            Int                        @id @default(autoincrement())
  email         String                     @unique
  passwordHash  String
  displayName   String?
  status        UserStatus
  roleId        Int
  role          Role                       @relation(fields:[roleId], references:[id])
  sessions      Session[]
  subscriptions Subscription?
  conversations Conversation[]
  searches      WebSearch[]
  usageLogs     ApiUsageLog[]
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([roleId])
  @@index([status])
}

enum UserStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  SUSPENDED = "SUSPENDED"
}

model Session {
  id        Int                @id @default(autoincrement())
  userId    Int
  user      User               @relation(fields:[userId], references:[id], onDelete: Cascade)
  tokenHash String             @unique
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  createdAt TimestamptzString  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Subscription {
  id                 Int                        @id @default(autoincrement())
  userId             Int                        @unique
  user               User                       @relation(fields:[userId], references:[id], onDelete: Cascade)
  plan               SubscriptionPlan
  status             SubscriptionStatus
  currentPeriodStart TimestamptzString
  currentPeriodEnd   TimestamptzString
  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([plan, status])
}

enum SubscriptionPlan {
  @@type("pg/text@1")

  FREE = "FREE"
  PREMIUM = "PREMIUM"
}

enum SubscriptionStatus {
  @@type("pg/text@1")

  ACTIVE = "ACTIVE"
  CANCELED = "CANCELED"
}

model AiProvider {
  id              Int                        @id @default(autoincrement())
  name            String
  type            ProviderType
  model           String
  encryptedApiKey String
  apiKeyIv        String
  apiKeyAuthTag   String
  enabled         Boolean                    @default(false)
  isDefault       Boolean                    @default(false)
  conversations   Conversation[]
  usageLogs       ApiUsageLog[]
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([type])
  @@index([enabled, isDefault])
}

enum ProviderType {
  @@type("pg/text@1")

  OPENAI = "OPENAI"
  ANTHROPIC = "ANTHROPIC"
  GEMINI = "GEMINI"
}

model Conversation {
  id         Int                        @id @default(autoincrement())
  userId     Int
  user       User                       @relation(fields:[userId], references:[id], onDelete: Cascade)
  providerId Int
  provider   AiProvider                 @relation(fields:[providerId], references:[id])
  messages   Message[]
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@index([userId, updatedAt])
  @@index([providerId])
}

model Message {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   Conversation      @relation(fields:[conversationId], references:[id], onDelete: Cascade)
  role           MessageRole
  content        String
  inputTokens    Int               @default(0)
  outputTokens   Int               @default(0)
  createdAt      TimestamptzString @default(now())

  @@index([conversationId, createdAt])
}

enum MessageRole {
  @@type("pg/text@1")

  SYSTEM = "SYSTEM"
  USER = "USER"
  ASSISTANT = "ASSISTANT"
}

model WebSearch {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields:[userId], references:[id], onDelete: Cascade)
  query           String
  normalizedQuery String
  results         SearchResult[]
  createdAt       TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([normalizedQuery, createdAt])
}

model SearchResult {
  id       Int       @id @default(autoincrement())
  searchId Int
  search   WebSearch @relation(fields:[searchId], references:[id], onDelete: Cascade)
  title    String
  url      String
  snippet  String

  @@unique([searchId, url])
  @@index([searchId])
}

model ApiUsageLog {
  id           Int               @id @default(autoincrement())
  userId       Int
  user         User              @relation(fields:[userId], references:[id], onDelete: Cascade)
  providerId   Int?
  provider     AiProvider?       @relation(fields:[providerId], references:[id])
  operation    ApiUsageOperation
  status       ApiUsageStatus
  inputTokens  Int               @default(0)
  outputTokens Int               @default(0)
  latencyMs    Int               @default(0)
  createdAt    TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([providerId, createdAt])
  @@index([operation, status, createdAt])
}

enum ApiUsageOperation {
  @@type("pg/text@1")

  CHAT = "CHAT"
  SEARCH = "SEARCH"
}

enum ApiUsageStatus {
  @@type("pg/text@1")

  SUCCESS = "SUCCESS"
  FAILED = "FAILED"
}
