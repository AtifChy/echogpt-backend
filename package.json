{
  "name": "echogpt-backend",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "composer:deploy": "prisma deploy module.ts",
    "composer:dev": "prisma dev module.ts",
    "contract:emit": "prisma contract emit",
    "db:down": "docker compose down",
    "db:init": "prisma db init",
    "db:up": "docker compose up -d --wait postgres",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "db:test:init": "dotenv run --override --file .env.test -- prisma db init",
    "db:test:update": "dotenv run --override --file .env.test -- prisma db update",
    "deploy": "bun run build && bun run composer:deploy",
    "dev": "bun --watch src/main.ts",
    "dev:composer": "bun run build && bun run composer:dev",
    "migrate": "prisma db migrate",
    "migrate:advance": "prisma db migrate --advance-ref db",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "bun dist/server.mjs",
    "postinstall": "prisma skills sync || exit 0",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun check",
    "admin:promote": "bun scripts/promote-admin.ts",
    "test": "bun test --isolate ./test/unit",
    "test:watch": "bun test --isolate --watch ./test/unit",
    "test:coverage": "bun test --isolate --coverage ./test/unit",
    "test:e2e": "bun test --isolate --timeout 30000 ./test/e2e",
    "test:all": "bun run test && bun run test:e2e",
    "test:typecheck": "bun check -p test/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/composer": "0.30.0",
    "@prisma/composer-prisma-cloud": "0.30.0",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "alchemy": "2.0.0-beta.83",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "openai": "^7.38.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@prisma/dev": "0.25.2",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "oxfmt": "^0.73.0",
    "prisma": "8.0.0-rc.23",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.1"
}
