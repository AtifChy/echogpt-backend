# Copy this file to `.env`.
# These development credentials match docker-compose.yml.
# Use managed secrets and different credentials outside local development.

DATABASE_URL="postgresql://echogpt:echogpt_dev@localhost:5432/echogpt"
NODE_ENV="development"
PORT=3000

# Add these when the corresponding roadmap steps are implemented.
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS="http://localhost:5173,chrome-extension://replace-extension-id"
PROVIDER_ENCRYPTION_KEY_BASE64="replace-with-32-random-bytes-in-base64"

# Add your Brave Search API key here. You can get one at https://brave.com/search/api/.
BRAVE_SEARCH_API_KEY="replace-with-your-brave-search-api-key"
SEARCH_CACHE_MINUTES=10
